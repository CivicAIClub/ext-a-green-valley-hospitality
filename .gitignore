# ── Client data: never commit (see data/README.md) ──────────────────────────
# data/ is ignored except its README (git cannot re-include a file inside an
# ignored directory, so the folder is ignored as data/* rather than data/).
data/*
!data/README.md
*.pdf
*.xlsx
*.xls
*.xlsm
*.csv

# Environment & secrets (keep .env.example)
.env
.env.*
!.env.example
*.key
*.pem

# Common build / dependency output (trim once the stack is chosen)
node_modules/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / AI tools
.vscode/settings.json
.idea/
.claude/
*.swp

# OS
.DS_Store
Thumbs.db
*.log
